{
  "name": "chirashitabi",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true VITE_MOCK=false vp build",
    "check:worker": "wrangler types && tsc -p src/worker",
    "deploy": "VITE_MOCK=false vp build && test ! -e dist/mockServiceWorker.js && wrangler deploy",
    "musea": "MUSEA=true vp dev --open /__musea__"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@pinia/colada": "^1.4.6",
    "evlog": "^2.29.0",
    "hono": "5.0.0-rc.1",
    "maplibre-gl": "^6.11.2",
    "messageformat": "^4.0.0",
    "pinia": "^4.0.3",
    "temporal-polyfill-lite": "^0.4.3",
    "uqr": "0.1.3",
    "valibot": "^1.5.0",
    "vue": "3.6.0-rc.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@vitejs/devtools": "^0.8.0",
    "@vitejs/devtools-rolldown": "^0.8.0",
    "@vitest/browser-playwright": "catalog:",
    "@vizejs/vite-plugin": "0.501.0",
    "@vizejs/vite-plugin-musea": "0.501.0",
    "@vue/devtools-api": "^8.2.1",
    "msw": "^3.0.2",
    "playwright": "catalog:",
    "typescript": "^5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.145.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  }
}
